{
  "version": 2,
  "installCommand": "npm run install",
  "buildCommand": "npm run build:vercel",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "deployment/vercel-output/client"
      }
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index.js?__vercel_api_path=$1"
    },
    {
      "src": "^/api/?$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/admin/(.*)$",
      "dest": "/admin/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
