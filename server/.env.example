# Server runtime configuration (never expose these values to Vite).
PORT=
NODE_ENV=
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=

# Optional browser origins; comma-separated origins can be listed in CORS_ORIGINS.
CLIENT_URL=
ADMIN_URL=
CORS_ORIGINS=

# Used only when creating an administrator with the create-admin/seed scripts.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
